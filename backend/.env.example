# server config
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/localvibe?retryWrites=true&w=majority

# SerpApi key for fetching real Google Events (free tier: serpapi.com)
SERP_API_KEY=your_serp_api_key_here

# frontend origin for CORS (comma-separated if multiple)
CORS_ORIGIN=http://localhost:5173
